# ─── Locomotive Digital Twin — Frontend Environment ───────────────────────────
# Copy to .env and adjust for your environment.
# ──────────────────────────────────────────────────────────────────────────────

# ── Local development (npm run dev) ───────────────────────────────────────────
# Vite proxy in vite.config.js rewrites /api → http://localhost:8000
# So the browser sends to localhost:5173/api/ws/telemetry and Vite proxies it.
VITE_WS_URL=ws://localhost:5173/api/ws/telemetry
VITE_API_URL=http://localhost:5173/api

# ── Docker Compose (served via nginx on port 80) ──────────────────────────────
# nginx.conf proxies /api → backend container.
# Uncomment these and comment the lines above when running via docker-compose:
# VITE_WS_URL=ws://localhost/api/ws/telemetry
# VITE_API_URL=http://localhost/api

# ── Backend WebSocket message format (for reference) ──────────────────────────
# type = "telemetry":
# {
#   "type": "telemetry",
#   "timestamp": "2024-01-01T12:00:00Z",
#   "locomotive_id": "LOC-001",
#   "data": {
#     "speed": 87.5,
#     "fuel_level": 68.2,
#     "pressure": 5.01,
#     "temperature": 81.3,
#     "position": { "lat": 43.12, "lng": 75.84, "km_marker": 148 }
#   },
#   "health": {
#     "index": 82.5,
#     "category": "B",
#     "label": "Attention",
#     "top_factors": [{ "parameter": "...", "score": 90, "weight": 0.3, "impact": 3, "status": "normal" }]
#   },
#   "alerts": [{ "id": 1, "severity": "warning", "code": "HIGH_TEMP", "message": "...", ... }]
# }
#
# type = "heartbeat":
# { "type": "heartbeat", "timestamp": "...", "connections": 2, "buffer_size": 100 }
