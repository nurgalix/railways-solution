# ─── Locomotive Digital Twin — Environment Variables ──────────────────────────
#
# Copy this file to `.env` and fill in the values for your environment.
# Values here are the defaults used when no .env file is present.
#
# IMPORTANT: Never commit your actual .env file to git.
# ──────────────────────────────────────────────────────────────────────────────

# WebSocket endpoint for live telemetry stream.
# The frontend tries this URL first; on failure it falls back to the built-in
# mock simulator automatically so the UI works without a backend.
#
# Expected message format (JSON, 1 Hz+):
# {
#   "timestamp": 1712345678000,
#   "speed": 87.5,
#   "fuel_level": 68.2,
#   "fuel_consumption": 63.1,
#   "pressure_brake": 5.01,
#   "pressure_main": 8.47,
#   "temp_engine": 81.3,
#   "temp_oil": 74.6,
#   "voltage": 612,
#   "current": 978,
#   "position": { "lat": 43.12, "lng": 75.84, "km": 148 },
#   "alerts": []
# }
VITE_WS_URL=ws://localhost:8000/ws/telemetry

# REST API base URL (for historical data, thresholds, export)
VITE_API_URL=http://localhost:8000/api
