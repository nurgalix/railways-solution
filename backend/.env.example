# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/railways
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/railways

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=super-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Simulator ────────────────────────────────────────────────
SIMULATOR_INTERVAL_MS=1000
SIMULATOR_ENABLED=true
SIMULATOR_LOCOMOTIVE_ID=LOC-001

# ── WebSocket ────────────────────────────────────────────────
WS_HEARTBEAT_SEC=30

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list handled by pydantic
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# ── Health Config ────────────────────────────────────────────
HEALTH_CONFIG_PATH=health_config.yaml

# ── Buffer ───────────────────────────────────────────────────
BUFFER_SIZE=1000
EMA_ALPHA=0.3

# ── Default Admin ────────────────────────────────────────────
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
